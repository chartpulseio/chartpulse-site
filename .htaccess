# Point t_cfg() to secrets file outside web root
SetEnv TORUS_CONFIG /home/u330623605/domains/chartpulse.io/cp_secrets/cp-config.php
# ===== ChartPulse .htaccess =====
Options -Indexes -MultiViews

# --- Force UTF-8 charset on all HTML responses (fixes Â·, â¦ garbage in browser)
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|php)$">
    Header always set Content-Type "text/html; charset=utf-8"
  </FilesMatch>
</IfModule>
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_rewrite.c>
RewriteEngine On

# --- canonical host: one 301 hop from http / www to https://chartpulse.io
RewriteCond %{HTTP_HOST} !^chartpulse\.io$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://chartpulse.io/$1 [R=301,L]

# --- block dotfiles (except .well-known for SSL/verification)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# --- block dev/sensitive folders
RewriteRule ^(tools|deploy|baseline|rollback|cache|inc|next)(/|$) - [F,L]

# --- 301 old URLs -> new URLs
# THE_REQUEST checks the ORIGINAL request so internal rewrites below cannot loop.
RewriteCond %{THE_REQUEST} \ /scanners\.html[? ]
RewriteRule ^scanners\.html$ /scanners/ [R=301,L]

RewriteCond %{THE_REQUEST} \ /strategies\.html[? ]
RewriteRule ^strategies\.html$ /scanners/ [R=301,L]

RewriteCond %{THE_REQUEST} \ /ema200\.html[? ]
RewriteRule ^ema200\.html$ /scanners/ema-200/ [R=301,L]

RewriteCond %{THE_REQUEST} \ /dashboard\.html[? ]
RewriteRule ^dashboard\.html$ /scanners/bottom-reversal/ [R=301,L]

RewriteCond %{THE_REQUEST} \ /day-drive\.html[? ]
RewriteRule ^day-drive\.html$ /scanners/day-drive/ [R=301,L]

RewriteCond %{THE_REQUEST} \ /trend-lines\.html[? ]
RewriteRule ^trend-lines\.html$ /scanners/trend-lines/ [R=301,L]

RewriteCond %{THE_REQUEST} \ /pro-backtesting(\.html)?[? ]
RewriteRule ^pro-backtesting(\.html)?$ /backtesting/ [R=301,L]

RewriteCond %{THE_REQUEST} \ /legal\.php\?p=(terms|privacy|refund|disclaimer)[ &]
RewriteRule ^legal\.php$ /legal/%1? [R=301,L]

RewriteCond %{THE_REQUEST} \ /legal\.php\?p=contact[ &]
RewriteRule ^legal\.php$ /contact/? [R=301,L]

# --- keep existing page URLs working where no redirect applies
RewriteRule ^news\.html$        /news.html         [L]
RewriteRule ^insights\.html$    /insights.html     [L]
RewriteRule ^pricing\.html$     /pricing.html      [L]

# --- clean URLs (new structure) -> real files
RewriteRule ^scanners/?$                                 /scanners.html               [L]
RewriteRule ^scanners/ema-200/?$                         /ema200.html                 [L]
RewriteRule ^scanners/bottom-reversal/?$                 /dashboard.html              [L]
RewriteRule ^scanners/day-drive/?$                       /day-drive.html              [L]
RewriteRule ^scanners/trend-lines/?$                     /trend-lines.html            [L]
RewriteRule ^backtesting/?$                              /pro-backtesting.html        [L]
RewriteRule ^legal/(terms|privacy|refund|disclaimer)/?$  /legal.php?p=$1              [L,QSA]
RewriteRule ^contact/?$                                  /legal.php?p=contact         [L,QSA]

# --- existing clean URLs
RewriteRule ^movers/?$                                   /movers.php                  [L,QSA]
RewriteRule ^movers/([0-9]{4}-[0-9]{2}-[0-9]{2})/?$      /movers.php?d=$1             [L,QSA]
RewriteRule ^bias/?$                                     /bias.php                    [L,QSA]
RewriteRule ^bias/([^/]+)/?$                             /bias.php?slug=$1            [L,QSA]
RewriteRule ^desk/?$                                     /desk.html                   [L,QSA]
RewriteRule ^sitemap\.xml$                               /sitemap.php                 [L]

</IfModule>

# --- block sensitive file types from web access
<FilesMatch "\.(sqlite|sqlite3|db|sql|log|bak|old|orig|prev|swp|env|ini|lock|md|py|yml|yaml|sh)$">
  Require all denied
</FilesMatch>

# --- block specific sensitive files
# dd_api.php is the Day Drive page's own endpoint -- it must stay reachable (blocking it turned the scanner off).
<FilesMatch "^(dd_engine|app|engine|test_engine|requirements)\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Staged: start at 5 minutes. Raise to six months after a clean week of HTTPS.
  # Do NOT add preload without the owner's written OK.
  Header always set Strict-Transport-Security "max-age=300"

  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"

  # CSP stage 1 - ENFORCED.
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"

  # CSP stage 2 - REPORT-ONLY.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://s3.tradingview.com https://www.tradingview-widget.com https://checkout.razorpay.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.razorpay.com; frame-src 'self' https://s.tradingview.com https://www.tradingview-widget.com https://api.razorpay.com; form-action 'self' https://api.razorpay.com; object-src 'none'; base-uri 'self'"

  # noindex for API endpoints
  <FilesMatch "^(api|dd_br_api|dd_api|health)\.php$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# --- Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
