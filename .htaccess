# ===== ChartPulse .htaccess =====
Options -Indexes -MultiViews
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_rewrite.c>
RewriteEngine On

# --- block dotfiles (except .well-known for SSL/verification)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# --- block dev/sensitive folders
RewriteRule ^(tools|deploy|baseline|rollback|cache|inc)(/|$) - [F,L]

# --- 301 redirects: old .html -> clean URLs
RewriteRule ^scanner\.html$     /scanner.html      [L]
RewriteRule ^news\.html$        /news.html         [L]
RewriteRule ^insights\.html$    /insights.html     [L]
RewriteRule ^pricing\.html$     /pricing.html      [L]
RewriteRule ^day-drive\.html$   /dashboard.html    [R=301,L]

# --- clean URLs for PHP/HTML pages (MultiViews is off, so map explicitly)
RewriteRule ^pro-backtesting/?$                          /pro-backtesting.html        [L,QSA]
RewriteRule ^movers/?$                                   /movers.php                  [L,QSA]
RewriteRule ^movers/([0-9]{4}-[0-9]{2}-[0-9]{2})/?$      /movers.php?d=$1             [L,QSA]
RewriteRule ^bias/?$                                     /bias.php                    [L,QSA]
RewriteRule ^bias/([^/]+)/?$                             /bias.php?slug=$1            [L,QSA]
RewriteRule ^desk/?$                                     /desk.html                   [L,QSA]
RewriteRule ^sitemap\.xml$                               /sitemap.php                 [L]

</IfModule>

# --- block sensitive file types from web access
<FilesMatch "\.(sqlite|sqlite3|db|sql|log|bak|old|orig|prev|swp|env|ini|lock|md|py|yml|yaml|sh)$">
  Require all denied
</FilesMatch>

# --- block specific sensitive files
<FilesMatch "^(dd_engine|dd_api|app|engine|test_engine|requirements)\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Staged: start at 5 minutes. Raise to six months after a clean week of HTTPS.
  # Do NOT add preload without the owner's written OK.
  Header always set Strict-Transport-Security "max-age=300"

  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"

  # CSP stage 1 - ENFORCED.
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"

  # CSP stage 2 - REPORT-ONLY.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://s3.tradingview.com https://www.tradingview-widget.com https://checkout.razorpay.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.razorpay.com; frame-src 'self' https://s.tradingview.com https://www.tradingview-widget.com https://api.razorpay.com; form-action 'self' https://api.razorpay.com; object-src 'none'; base-uri 'self'"

  # noindex for API endpoints
  <FilesMatch "^(api|dd_br_api|dd_api|health)\.php$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# --- Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
